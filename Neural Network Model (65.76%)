# Import necessary libraries
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.metrics import classification_report, accuracy_score
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
import tensorflow as tf
from tensorflow.keras import layers, models
from tensorflow.keras.callbacks import EarlyStopping
from tensorflow.keras.optimizers import Adam
from xgboost import XGBClassifier
from google.colab import files

# Step 1: Upload the file
uploaded = files.upload()

# Step 2: Load the data and compute initial correlations
data = pd.read_excel('resampled_loan_data.xlsx')
print("Class distribution of loan_paid:")
print(data['loan_paid'].value_counts(normalize=True))

# Use raw numeric columns available in the original data
raw_numerical_cols = [
    'loan_amnt', 'pub_rec_bankruptcies', 'tax_liens', 'tot_hi_cred_lim',
    'total_bal_ex_mort', 'total_bc_limit', 'total_il_high_credit_limit',
    'annual_inc', 'collections_12_mths_ex_med', 'delinq_2yrs', 'dti',
    'inq_last_6mths', 'installment', 'int_rate', 'pub_rec', 'revol_util',
    'total_acc'
]
print("Initial feature correlations with loan_paid (raw data):")
correlations = data[raw_numerical_cols].corrwith(data['loan_paid'])
print(correlations.sort_values(ascending=False))

# Step 3: Drop columns not available at loan application time (if they exist)
columns_to_drop = ['last_pymnt_d', 'out_prncp', 'out_prncp_inv', 'debt_settlement_flag']
columns_to_drop = [col for col in columns_to_drop if col in data.columns]
data = data.drop(columns_to_drop, axis=1)

# Step 4: Define target and feature columns
target = 'loan_paid'
features = data.columns.drop(target)

# Step 5: Split data into training and testing sets
train_data, test_data = train_test_split(data, test_size=0.2, random_state=42)

# Step 6: Map 'emp_length' to numerical values
emp_length_mapping = {
    '< 1 year': 0, '1 year': 1, '2 years': 2, '3 years': 3, '4 years': 4,
    '5 years': 5, '6 years': 6, '7 years': 7, '8 years': 8, '9 years': 9,
    '10+ years': 10
}
train_data['emp_length'] = train_data['emp_length'].map(emp_length_mapping)
test_data['emp_length'] = test_data['emp_length'].map(emp_length_mapping)

# Step 7: Map 'grade' to numerical values
grade_mapping = {'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7}
train_data['grade'] = train_data['grade'].map(grade_mapping)
test_data['grade'] = test_data['grade'].map(grade_mapping)

# Step 8: Preprocess 'earliest_cr_line' and add new features
reference_date = pd.to_datetime('2019-01-01')
train_data['earliest_cr_line'] = pd.to_datetime(train_data['earliest_cr_line'])
test_data['earliest_cr_line'] = pd.to_datetime(test_data['earliest_cr_line'])
train_data['years_since_earliest_cr_line'] = (reference_date - train_data['earliest_cr_line']).dt.days / 365.25
test_data['years_since_earliest_cr_line'] = (reference_date - test_data['earliest_cr_line']).dt.days / 365.25
train_data = train_data.drop('earliest_cr_line', axis=1)
test_data = test_data.drop('earliest_cr_line', axis=1)

# Convert to numeric, coercing errors to NaN
train_data['int_rate'] = pd.to_numeric(train_data['int_rate'], errors='coerce')
test_data['int_rate'] = pd.to_numeric(test_data['int_rate'], errors='coerce')
train_data['dti'] = pd.to_numeric(train_data['dti'], errors='coerce')
test_data['dti'] = pd.to_numeric(test_data['dti'], errors='coerce')
train_data['loan_amnt'] = pd.to_numeric(train_data['loan_amnt'], errors='coerce')
test_data['loan_amnt'] = pd.to_numeric(test_data['loan_amnt'], errors='coerce')
train_data['annual_inc'] = pd.to_numeric(train_data['annual_inc'], errors='coerce')
test_data['annual_inc'] = pd.to_numeric(test_data['annual_inc'], errors='coerce')

# Avoid division by zero in loan_to_income
train_data['annual_inc'] = train_data['annual_inc'].replace(0, 1)  # Replace 0 with 1
test_data['annual_inc'] = test_data['annual_inc'].replace(0, 1)

# Add engineered features
train_data['log_annual_inc'] = np.log1p(train_data['annual_inc'])
test_data['log_annual_inc'] = np.log1p(test_data['annual_inc'])
train_data['log_loan_amnt'] = np.log1p(train_data['loan_amnt'])
test_data['log_loan_amnt'] = np.log1p(test_data['loan_amnt'])
train_data['int_rate_grade'] = train_data['int_rate'] * train_data['grade']
test_data['int_rate_grade'] = test_data['int_rate'] * test_data['grade']
train_data['loan_amnt_dti'] = train_data['log_loan_amnt'] * train_data['dti']
test_data['loan_amnt_dti'] = test_data['log_loan_amnt'] * test_data['dti']
train_data['loan_to_income'] = train_data['loan_amnt'] / train_data['annual_inc']
test_data['loan_to_income'] = test_data['loan_amnt'] / test_data['annual_inc']

# Replace infinities with NaN
train_data.replace([np.inf, -np.inf], np.nan, inplace=True)
test_data.replace([np.inf, -np.inf], np.nan, inplace=True)

# Step 9: Define numerical and categorical columns
numerical_cols = [
    'log_loan_amnt', 'pub_rec_bankruptcies', 'tax_liens', 'tot_hi_cred_lim',
    'total_bal_ex_mort', 'total_bc_limit', 'total_il_high_credit_limit',
    'log_annual_inc', 'collections_12_mths_ex_med', 'delinq_2yrs', 'dti',
    'inq_last_6mths', 'installment', 'int_rate', 'pub_rec', 'revol_util',
    'total_acc', 'years_since_earliest_cr_line', 'emp_length', 'grade',
    'int_rate_grade', 'loan_amnt_dti', 'loan_to_income'
]
categorical_cols = ['verification_status', 'disbursement_method', 'home_ownership', 'purpose', 'term']

# Step 10: Create preprocessing pipelines
num_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])
cat_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])
preprocessor = ColumnTransformer(
    transformers=[
        ('num', num_transformer, numerical_cols),
        ('cat', cat_transformer, categorical_cols)
    ])

# Step 11: Fit and transform training data
X_train = preprocessor.fit_transform(train_data[numerical_cols + categorical_cols])
y_train = train_data[target].values
X_test = preprocessor.transform(test_data[numerical_cols + categorical_cols])
y_test = test_data[target].values

# Compute correlations with preprocessed features
print("\nFeature correlations with loan_paid (preprocessed training data):")
preprocessed_data = pd.DataFrame(X_train, columns=numerical_cols + preprocessor.named_transformers_['cat']['onehot'].get_feature_names_out(categorical_cols).tolist())
correlations_preprocessed = preprocessed_data[numerical_cols].corrwith(pd.Series(y_train))
print(correlations_preprocessed.sort_values(ascending=False))

# Step 12: Feature selection with Random Forest
rf = RandomForestClassifier(n_estimators=100, random_state=42)
rf.fit(X_train, y_train)
importances = rf.feature_importances_
feature_names = numerical_cols + preprocessor.named_transformers_['cat']['onehot'].get_feature_names_out(categorical_cols).tolist()
top_indices = np.argsort(importances)[::-1][:20]
X_train_selected = X_train[:, top_indices]
X_test_selected = X_test[:, top_indices]
print("Top 20 features:", [feature_names[i] for i in top_indices])

# Step 13: Build and train a deeper neural network
model = models.Sequential([
    layers.Input(shape=(X_train_selected.shape[1],)),
    layers.Dense(256, activation='relu'),
    layers.BatchNormalization(),
    layers.Dropout(0.4),
    layers.Dense(128, activation='relu'),
    layers.BatchNormalization(),
    layers.Dropout(0.4),
    layers.Dense(64, activation='relu'),
    layers.Dropout(0.3),
    layers.Dense(1, activation='sigmoid')
])
model.compile(optimizer=Adam(learning_rate=0.0005), loss='binary_crossentropy', metrics=['accuracy'])
early_stopping = EarlyStopping(monitor='val_loss', patience=15, restore_best_weights=True)
model.fit(X_train_selected, y_train, epochs=100, batch_size=128, validation_split=0.2, callbacks=[early_stopping], verbose=1)

# Step 14: Evaluate the neural network
test_loss, test_accuracy = model.evaluate(X_test_selected, y_test, verbose=0)
print(f"\nNeural Network Test Accuracy: {test_accuracy:.4f}")

# Step 15: Optimize XGBoost with GridSearchCV
param_grid = {
    'n_estimators': [100, 200, 300],
    'max_depth': [3, 5, 7],
    'learning_rate': [0.01, 0.1, 0.3],
    'subsample': [0.8, 1.0]
}
xgb = XGBClassifier(random_state=42, eval_metric='logloss')
grid_search = GridSearchCV(xgb, param_grid, cv=3, scoring='accuracy', verbose=1, n_jobs=-1)
grid_search.fit(X_train, y_train)
best_xgb = grid_search.best_estimator_
xgb_accuracy = best_xgb.score(X_test, y_test)
print(f"Optimized XGBoost Test Accuracy: {xgb_accuracy:.4f}")
print(f"Best Parameters: {grid_search.best_params_}")

# Step 16: Stacking ensemble
nn_pred_train = model.predict(X_train_selected).flatten()
xgb_pred_train = best_xgb.predict_proba(X_train)[:, 1]
stacked_train = np.column_stack((nn_pred_train, xgb_pred_train))
nn_pred_test = model.predict(X_test_selected).flatten()
xgb_pred_test = best_xgb.predict_proba(X_test)[:, 1]
stacked_test = np.column_stack((nn_pred_test, xgb_pred_test))
meta_model = LogisticRegression()
meta_model.fit(stacked_train, y_train)
stacked_pred = meta_model.predict(stacked_test)
stacked_accuracy = accuracy_score(y_test, stacked_pred)
print(f"Stacked Ensemble Test Accuracy: {stacked_accuracy:.4f}")

# Additional evaluation
print("\nClassification Report (Stacked Ensemble):")
print(classification_report(y_test, stacked_pred))
