# Import necessary libraries
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.utils.class_weight import compute_class_weight
from sklearn.metrics import classification_report
import tensorflow as tf
from tensorflow.keras import layers, models
from tensorflow.keras.callbacks import EarlyStopping
from tensorflow.keras.optimizers import Adam
from google.colab import files

# Step 1: Upload the file
uploaded = files.upload()

# Step 2: Load the data
data = pd.read_excel('resampled_loan_data.xlsx')
print("Class distribution of loan_paid:")
print(data['loan_paid'].value_counts(normalize=True))

# Step 3: Drop columns not available at loan application time (if they exist)
columns_to_drop = ['last_pymnt_d', 'out_prncp', 'out_prncp_inv', 'debt_settlement_flag']
columns_to_drop = [col for col in columns_to_drop if col in data.columns]
data = data.drop(columns_to_drop, axis=1)

# Step 4: Define target and feature columns
target = 'loan_paid'
features = data.columns.drop(target)

# Step 5: Split data into training and testing sets
train_data, test_data = train_test_split(data, test_size=0.2, random_state=42)

# Step 6: Preprocess 'earliest_cr_line' and add log features
reference_date = pd.to_datetime('2019-01-01')
train_data['earliest_cr_line'] = pd.to_datetime(train_data['earliest_cr_line'])
test_data['earliest_cr_line'] = pd.to_datetime(test_data['earliest_cr_line'])
train_data['years_since_earliest_cr_line'] = (reference_date - train_data['earliest_cr_line']).dt.days / 365.25
test_data['years_since_earliest_cr_line'] = (reference_date - test_data['earliest_cr_line']).dt.days / 365.25
train_data = train_data.drop('earliest_cr_line', axis=1)
test_data = test_data.drop('earliest_cr_line', axis=1)
train_data['log_annual_inc'] = np.log1p(train_data['annual_inc'])
test_data['log_annual_inc'] = np.log1p(test_data['annual_inc'])
train_data['log_loan_amnt'] = np.log1p(train_data['loan_amnt'])
test_data['log_loan_amnt'] = np.log1p(test_data['loan_amnt'])

# Step 7: Map 'emp_length' to numerical values
emp_length_mapping = {
    '< 1 year': 0, '1 year': 1, '2 years': 2, '3 years': 3, '4 years': 4,
    '5 years': 5, '6 years': 6, '7 years': 7, '8 years': 8, '9 years': 9,
    '10+ years': 10
}
train_data['emp_length'] = train_data['emp_length'].map(emp_length_mapping)
test_data['emp_length'] = test_data['emp_length'].map(emp_length_mapping)

# Step 8: Map 'grade' to numerical values
grade_mapping = {'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7}
train_data['grade'] = train_data['grade'].map(grade_mapping)
test_data['grade'] = test_data['grade'].map(grade_mapping)

# Step 9: Define numerical and categorical columns
numerical_cols = [
    'log_loan_amnt', 'pub_rec_bankruptcies', 'tax_liens', 'tot_hi_cred_lim',
    'total_bal_ex_mort', 'total_bc_limit', 'total_il_high_credit_limit',
    'log_annual_inc', 'collections_12_mths_ex_med', 'delinq_2yrs', 'dti',
    'inq_last_6mths', 'installment', 'int_rate', 'pub_rec', 'revol_util',
    'total_acc', 'years_since_earliest_cr_line', 'emp_length', 'grade'
]
categorical_cols = ['verification_status', 'disbursement_method', 'home_ownership', 'purpose', 'term']

# Step 10: Create preprocessing pipelines
num_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])
cat_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])
preprocessor = ColumnTransformer(
    transformers=[
        ('num', num_transformer, numerical_cols),
        ('cat', cat_transformer, categorical_cols)
    ])

# Step 11: Fit and transform training data
X_train = preprocessor.fit_transform(train_data[numerical_cols + categorical_cols])
y_train = train_data[target].values
X_test = preprocessor.transform(test_data[numerical_cols + categorical_cols])
y_test = test_data[target].values

# Step 12: Build the neural network with Input layer
model = models.Sequential([
    layers.Input(shape=(X_train.shape[1],)),  # Explicit Input layer
    layers.Dense(128, activation='relu'),
    layers.Dropout(0.3),
    layers.Dense(64, activation='relu'),
    layers.Dropout(0.3),
    layers.Dense(32, activation='relu'),
    layers.Dense(1, activation='sigmoid')
])

# Step 13: Compile the model
model.compile(optimizer=Adam(learning_rate=0.001),
              loss='binary_crossentropy',
              metrics=['accuracy'])

# Step 14: Train the model with class weights and early stopping
class_weights = compute_class_weight('balanced', classes=np.unique(y_train), y=y_train)
class_weight_dict = dict(enumerate(class_weights))
early_stopping = EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)
history = model.fit(X_train, y_train,
                    epochs=100,
                    batch_size=64,
                    validation_split=0.2,
                    class_weight=class_weight_dict,
                    callbacks=[early_stopping],
                    verbose=1)

# Step 15: Evaluate the model
test_loss, test_accuracy = model.evaluate(X_test, y_test, verbose=0)
print(f"\nTest Accuracy: {test_accuracy:.4f}")

# Additional evaluation
y_pred = (model.predict(X_test) > 0.5).astype(int)
print("\nClassification Report:")
print(classification_report(y_test, y_pred))
