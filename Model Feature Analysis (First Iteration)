import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from google.colab import files

# Step 1: Upload and load the data
uploaded = files.upload()
data = pd.read_excel('resampled_loan_data.xlsx')
print("Class distribution of loan_paid:")
print(data['loan_paid'].value_counts(normalize=True))

# Step 2: Drop columns not available at loan application time (if they exist)
columns_to_drop = ['last_pymnt_d', 'out_prncp', 'out_prncp_inv', 'debt_settlement_flag']
columns_to_drop = [col for col in columns_to_drop if col in data.columns]
data = data.drop(columns_to_drop, axis=1)

# Step 3: Define target
target = 'loan_paid'

# Step 4: Split data into training and testing sets (we’ll analyze training data)
train_data, test_data = train_test_split(data, test_size=0.2, random_state=42)

# Step 5: Preprocess and engineer features (same as before)
reference_date = pd.to_datetime('2019-01-01')
train_data['earliest_cr_line'] = pd.to_datetime(train_data['earliest_cr_line'])
train_data['years_since_earliest_cr_line'] = (reference_date - train_data['earliest_cr_line']).dt.days / 365.25
train_data = train_data.drop('earliest_cr_line', axis=1)

# Convert to numeric
train_data['int_rate'] = pd.to_numeric(train_data['int_rate'], errors='coerce')
train_data['dti'] = pd.to_numeric(train_data['dti'], errors='coerce')
train_data['loan_amnt'] = pd.to_numeric(train_data['loan_amnt'], errors='coerce')
train_data['annual_inc'] = pd.to_numeric(train_data['annual_inc'], errors='coerce').replace(0, 1)  # Avoid division by zero

# Map categorical variables
emp_length_mapping = {'< 1 year': 0, '1 year': 1, '2 years': 2, '3 years': 3, '4 years': 4,
                      '5 years': 5, '6 years': 6, '7 years': 7, '8 years': 8, '9 years': 9, '10+ years': 10}
train_data['emp_length'] = train_data['emp_length'].map(emp_length_mapping)
grade_mapping = {'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7}
train_data['grade'] = train_data['grade'].map(grade_mapping)

# Engineer features
train_data['log_annual_inc'] = np.log1p(train_data['annual_inc'])
train_data['log_loan_amnt'] = np.log1p(train_data['loan_amnt'])
train_data['int_rate_grade'] = train_data['int_rate'] * train_data['grade']
train_data['loan_amnt_dti'] = train_data['log_loan_amnt'] * train_data['dti']
train_data['loan_to_income'] = train_data['loan_amnt'] / train_data['annual_inc']

# Replace infinities with NaN
train_data.replace([np.inf, -np.inf], np.nan, inplace=True)

# Step 6: Define feature lists
numerical_cols = [
    'loan_amnt', 'pub_rec_bankruptcies', 'tax_liens', 'tot_hi_cred_lim',
    'total_bal_ex_mort', 'total_bc_limit', 'total_il_high_credit_limit',
    'annual_inc', 'collections_12_mths_ex_med', 'delinq_2yrs', 'dti',
    'inq_last_6mths', 'installment', 'int_rate', 'pub_rec', 'revol_util',
    'total_acc', 'years_since_earliest_cr_line', 'emp_length', 'grade',
    'log_loan_amnt', 'log_annual_inc', 'int_rate_grade', 'loan_amnt_dti', 'loan_to_income'
]
categorical_cols = ['verification_status', 'disbursement_method', 'home_ownership', 'purpose', 'term']

# Ensure only existing columns are used
numerical_cols = [col for col in numerical_cols if col in train_data.columns]
categorical_cols = [col for col in categorical_cols if col in train_data.columns]

# Step 7: Analyze Categorical Variables
print("\n=== Categorical Feature Analysis ===")
for col in categorical_cols:
    # Group by category and calculate counts and default rates
    analysis = train_data.groupby(col).agg(
        count=('loan_paid', 'size'),
        default_count=('loan_paid', lambda x: (x == 0).sum())
    ).reset_index()
    analysis['default_rate'] = analysis['default_count'] / analysis['count']
    print(f"\nFeature: {col}")
    print(analysis)
    # Assess predictability by variance in default rates
    variance = analysis['default_rate'].var()
    print(f"Variance in default rates: {variance:.4f}")

# Step 8: Analyze Numeric Variables
print("\n=== Numeric Feature Analysis ===")
for col in numerical_cols:
    # Skip if column has too many NaNs or no variation
    if train_data[col].isna().all() or train_data[col].nunique() <= 1:
        print(f"\nFeature: {col} - Skipped (all NaN or no variation)")
        continue
    
    # Bin into deciles
    train_data[col + '_bin'] = pd.qcut(train_data[col].dropna(), q=10, duplicates='drop')
    analysis = train_data.groupby(col + '_bin', observed=True).agg(
        count=('loan_paid', 'size'),
        default_count=('loan_paid', lambda x: (x == 0).sum())
    ).reset_index()
    analysis['default_rate'] = analysis['default_count'] / analysis['count']
    print(f"\nFeature: {col}")
    print(analysis)
    # Assess predictability by variance in default rates
    variance = analysis['default_rate'].var()
    print(f"Variance in default rates: {variance:.4f}")

# Step 9: Feature Selection Recommendation
print("\n=== Feature Selection Recommendation ===")
print("Select features with high variance in default rates (e.g., > 0.01) or clear trends in default rates.")
print("Categorical: Look for significant differences in default rates across categories.")
print("Numeric: Look for monotonic trends or high variance across bins.")
print("Based on output, manually review and select top features (e.g., 10-15 with strongest patterns).")



